# ============================================
# Lumina Career ROI — Environment Configuration
# ============================================

# ---------- Cloudflare R2 (Data Backup) ----------
R2_BUCKET_NAME=your-private-bucket-name
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_ENDPOINT_URL=https://<your-account-id>.r2.cloudflarestorage.com

# ---------- Job Board API Keys (Optional) ----------
# Adzuna (free API key at https://developer.adzuna.com/)
ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_APP_KEY=your-adzuna-app-key

# USAJobs (free API key at https://developer.usajobs.gov/)
USAJOBS_API_KEY=your-usajobs-api-key

# Jooble (free API key at https://jooble.org/api/about)
# JOOBLE_API_KEY=your-jooble-api-key

# ---------- Frontend / API ----------
# URL the frontend uses to reach the backend API
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ---------- Local Data Paths (Optional) ----------
# Root for bronze/, silver/, gold/, quarantine/. Defaults to ./data.
# Export this before starting Python (or provide it via env_file in Docker).
# LUMINA_DATA_DIR=/tmp/opencode/lumina-scratch

# Ingestion watermark file. Defaults to ./configs/ingestion_state.json.
# Point this into scratch space for scratch ingestion runs.
# LUMINA_STATE_FILE=/tmp/opencode/lumina-scratch/ingestion_state.json
